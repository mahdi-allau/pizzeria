# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit real secrets.
#
# Zero-config development: with none of these set, `npm run dev` still works —
# an embedded Postgres (PGlite) is created in .data/, payments are SIMULATED,
# emails are written to .data/mailbox/, and the admin password is "pizza".
# Everything below is for real services / production.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used in emails, redirects, metadata). No trailing slash.
APP_URL=http://localhost:3000

# ── Database (Postgres: Neon or Supabase) ────────────────────────────────────
# Unset in development = embedded PGlite. REQUIRED in production.
# Neon:     use the *pooled* connection string (host contains "-pooler"), ?sslmode=require
# Supabase: use the "Transaction pooler" string (port 6543)
DATABASE_URL=

# ── Admin (/admin) ───────────────────────────────────────────────────────────
# Generate a hash with:  npm run admin:hash -- "your long password"
ADMIN_PASSWORD_HASH=
# (alternative, less safe) plain password:
ADMIN_PASSWORD=
# 32+ random characters, signs the admin session cookie. e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=

# ── Stripe (TEST MODE ONLY) ──────────────────────────────────────────────────
# Dashboard → Developers → API keys (use the *test* keys: sk_test_… / pk_test_…).
# Live keys (sk_live_…) are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Local:  stripe listen --forward-to localhost:3000/api/stripe/webhook   (prints whsec_…)
# Hosted: Dashboard → Developers → Webhooks → endpoint https://YOUR-DOMAIN/api/stripe/webhook
#         events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled,
#                 charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=
# Leave unset. Only an explicit "true" lets live keys through.
STRIPE_ALLOW_LIVE=
# "stripe" or "mock". Unset = stripe if STRIPE_SECRET_KEY is set, else mock (development only).
PAYMENTS_PROVIDER=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g.  Pizzeria La Brace <ordini@tuodominio.it>
EMAIL_FROM=
# Where "new order" alerts go (also editable in /admin/impostazioni).
ORDER_NOTIFICATION_EMAIL=

# ── Housekeeping (Vercel Cron sends this as a Bearer token) ──────────────────
CRON_SECRET=

# ── Advanced ─────────────────────────────────────────────────────────────────
# Force development helpers (simulated payments, embedded DB, local mailbox) on/off.
# They are always OFF on a Vercel production deployment, whatever this says.
DEV_FEATURES=
# Where the embedded dev database lives (default .data/pglite).
PGLITE_DATA_DIR=
